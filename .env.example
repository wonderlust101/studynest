# Copy this file to .env.local. Put real secrets only in .env.local, never here.
# Default: local Docker database (safe to commit, the password is a throwaway).
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main

# Neon only: `neon deploy` fills these in, including its own DATABASE_URL.
# DATABASE_URL_UNPOOLED=
